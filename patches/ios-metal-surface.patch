+/* Observe allocation failures without changing descriptor/shader behavior. */
+static id<MTLRenderPipelineState> ios_profiled_pipeline(id<MTLDevice> device,
+        MTLRenderPipelineDescriptor* descriptor, NSError** error)
+{
+#if TARGET_OS_IPHONE
+    if (game_telemetry_pipeline) game_telemetry_pipeline(0, CACurrentMediaTime());
+#endif
+    id<MTLRenderPipelineState> result = [device newRenderPipelineStateWithDescriptor:descriptor error:error];
+#if TARGET_OS_IPHONE
+    if (game_telemetry_pipeline) game_telemetry_pipeline(result ? 1 : 2, CACurrentMediaTime());
+#endif
+    return result;
+}
+
+/* Diagnostic counters observe real backend submissions; they do not count
+ * synthetic host frames as guest game frames, or add a per-frame GPU wait. */
+static void surface_track_submission(id<MTLCommandBuffer> cb, id<CAMetalDrawable> drawable)
+{
+#if TARGET_OS_IPHONE
+    if (!drawable) return;
+    const uint64_t sequence = __atomic_add_fetch(&s_ios_submitted, 1, __ATOMIC_RELAXED);
+#if !TARGET_OS_SIMULATOR
+    [drawable addPresentedHandler:^(id<MTLDrawable> shown) {
+        if (game_telemetry_present) game_telemetry_present(shown.presentedTime);
+        __atomic_add_fetch(&s_ios_presented, 1, __ATOMIC_RELAXED);
+    }];
+#endif
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> finished) {
+        if (finished.status == MTLCommandBufferStatusCompleted) {
+            if (game_telemetry_gpu && finished.GPUEndTime > finished.GPUStartTime && finished.GPUStartTime > 0)
+                game_telemetry_gpu(CACurrentMediaTime(), (finished.GPUEndTime - finished.GPUStartTime) * 1000.0);
+            __atomic_add_fetch(&s_ios_completed, 1, __ATOMIC_RELAXED);
+        } else {
+            __atomic_add_fetch(&s_ios_errors, 1, __ATOMIC_RELAXED);
+        }
+        if (sequence <= 3 || finished.error)
+            fprintf(stderr, "[RSX surface] submission=%llu status=%lu error=%s\n",
+                (unsigned long long)sequence, (unsigned long)finished.status,
+                finished.error ? finished.error.localizedDescription.UTF8String : "none");
+    }];
+#else
+    (void)cb; (void)drawable;
+#endif
+}
 
